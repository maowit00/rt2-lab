cmake_minimum_required(VERSION 3.13)

########################################################
# use ARM on RP2040
########################################################
set(PICO_PLATFORM rp2040)
#set(PICO_BOARD waveshare_rp2040_lcd_1.28)
set(PICO_BOARD pico)

# initialize the SDK based on PICO_SDK_PATH
# note: this must happen before project()
include($ENV{PICO_SDK_PATH}/pico_sdk_init.cmake)
include($ENV{PICO_SDK_PATH}/external/pico_sdk_import.cmake)

project(motorboard)

# initialize the Raspberry Pi Pico SDK
pico_sdk_init()

set_source_files_properties(
     src/main.c 
     src/hal.c
     src/utils.c
         )

add_executable(motorboard 
     src/main.c 
     src/hal.c
     src/utils.c
     pio/quadrature_encoder_substep.c
     )

pico_generate_pio_header(motorboard ${CMAKE_CURRENT_LIST_DIR}/pio/quadrature_encoder_substep.pio)

target_include_directories(motorboard
     PRIVATE include 
     ) 


# enable USB CDC stdio 
pico_enable_stdio_usb(motorboard 1)   
pico_enable_stdio_uart(motorboard 0)   

# pull in common dependencies
target_link_libraries(motorboard 
    PRIVATE pico_stdlib
    PRIVATE hardware_i2c
    PRIVATE hardware_adc
    PRIVATE hardware_pwm
    PRIVATE pico_multicore
    PRIVATE hardware_pio
    PRIVATE hardware_watchdog
    )

# rest of your project


# create map/bin/hex/uf2 file etc.
pico_add_extra_outputs(motorboard)
